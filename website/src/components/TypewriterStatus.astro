---
// TypewriterStatus.astro - rotating typewriter with randomized statuses,
// a live busy flag from Jack's Google Calendar, and a real visitor count.
---

<h3 class="typewriter">
  <span class="typewriter-prefix">Currently </span>
  <span class="typewriter-text"></span>
  <span class="typewriter-cursor">|</span>
</h3>

<style>
  .typewriter-cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 50% {
      opacity: 1;
    }
    51%, 100% {
      opacity: 0;
    }
  }

  .typewriter {
    max-width: min(40rem, 90vw);
    min-height: 3.2em;
    margin: 0 auto;
  }

  .typewriter-text {
    display: inline;
  }
</style>

<script>
  // When the calendar says Jack is in something, this pool takes over.
  const busyStatuses = [
    { text: 'in a meeting rn — back soon' },
    { text: 'booked rn, my calendar made me say this' },
    { text: 'heads down rn (calendar-confirmed busy)' },
    { text: 'occupied — the calendar snitched on me' },
    { text: 'busy until further notice, per google calendar' },
  ];

  const freeStatuses = [
    { text: 'building strange agentic things at @ MAGK', link: 'https://magk.app' },
    { text: 'building juno, the newest experiment' },
    { text: 'maintaining rolo, the relationship brain that knows who i owe a reply' },
    { text: 'occasionally attending georgia tech' },
    { text: 'accidentally ended up on the news, oops', link: '/press' },
    { text: 'curating my second brain', link: 'https://jackipedia.agentschool.io' },
    { text: 'teaching stuff at learn.jack-luo.com', link: 'https://learn.jack-luo.com' },
    { text: 'training for the t run — every mbta station, one day', link: 'https://mbta-route-studio.vercel.app' },
    { text: 'day whatever of the gym streak' },
    { text: 'writing liminal chapters nobody asked for' },
    { text: 'making beats i will never release' },
    { text: 'somewhere between atlanta and boston rn' },
    { text: 'plotting a slightly unhinged trip to europe' },
    { text: 'ordering hotpot alone at 1am' },
    { text: 'listening to jpop remixes on loop' },
    { text: 'dreaming in transit maps' },
    { text: 'reading manga and calling it research' },
    { text: 'packing for a trip i planned 20 minutes ago' },
    { text: 'answering emails at unreasonable hours' },
    { text: 'rereading "the subtle art of not giving a f*ck" and pretending it is not about me' },
    { text: 'wiring up memory architectures so agents remember your life better than you do' },
    { text: 'accidentally meeting new friends everywhere' },
    { text: 'sleeping in a conference room again' },
    { text: 'quietly looking for a partner in crime who thinks late night bug hunting counts as a date :p' },
    { text: 'easing off the networking gas pedal so i can actually deepen the connections i already have' },
    { text: 'procrastinating by updating this website instead of resting' },
    { text: 'wait, you are still here scrolling this?' },
  ];

  let isBusy = null;
  let visitorCount = null;

  // Live busy flag — polled every 5 min; event details never reach the client.
  async function pollBusy() {
    try {
      const r = await fetch('/.netlify/functions/calendar-busy');
      const j = await r.json();
      if (j.busy !== isBusy) {
        isBusy = j.busy;
        // pool switched — refill the bag so busy/free statuses surface now
        bag = [];
      }
    } catch {}
    setTimeout(pollBusy, 5 * 60 * 1000);
  }
  pollBusy();

  // Real visitor count — one increment per browser session.
  (async () => {
    const counted = sessionStorage.getItem('jk-counted');
    try {
      const r = await fetch('/.netlify/functions/visitor-count', {
        method: counted ? 'GET' : 'POST',
      });
      const j = await r.json();
      if (j.count) {
        visitorCount = j.count;
        // only mark counted when the increment actually landed — a failed
        // POST gets retried on the next page load
        if (!counted) sessionStorage.setItem('jk-counted', '1');
      }
    } catch {}
  })();

  // Shuffled-bag rotation so the order is different every visit and
  // nothing repeats until the whole pool has been seen.
  let bag = [];
  let lastText = '';

  function nextStatus() {
    const pool = isBusy ? busyStatuses : freeStatuses;
    if (bag.length === 0) {
      bag = [...pool].sort(() => Math.random() - 0.5);
      // avoid an immediate repeat of what was just shown
      if (bag.length > 1 && bag[bag.length - 1].text === lastText) {
        bag.unshift(bag.pop());
      }
    }
    return bag.pop();
  }

  function getText(s) {
    if (s.isVisitor) {
      const n = visitorCount ?? Math.floor(Math.random() * 1000) + 1000;
      return `welcome to the chaos. you are visitor #${n}`;
    }
    return s.text;
  }

  const typewriterTextElement = document.querySelector('.typewriter-text');

  let charIndex = 0;
  let deleting = false;
  let paused = false;

  const TYPE_MS = 100;
  const DELETE_MS = 50;
  const PAUSE_TYPED = 3000;
  const PAUSE_DELETED = 500;

  let current = null;

  function tick() {
    if (paused || !typewriterTextElement) return;
    if (!current) {
      current = nextStatus();
      lastText = current.text;
      charIndex = 0;
    }
    const full = getText(current);

    if (!deleting) {
      charIndex++;
      const shown = full.substring(0, charIndex);
      if (current.link && charIndex === full.length) {
        typewriterTextElement.innerHTML = `<a href="${current.link}" target="_blank" rel="noopener">${shown}</a>`;
      } else {
        typewriterTextElement.textContent = shown;
      }
      if (charIndex === full.length) {
        paused = true;
        setTimeout(() => {
          paused = false;
          deleting = true;
          tick();
        }, PAUSE_TYPED);
        return;
      }
    } else {
      charIndex--;
      typewriterTextElement.textContent = full.substring(0, charIndex);
      if (charIndex === 0) {
        deleting = false;
        current = null;
        paused = true;
        setTimeout(() => {
          paused = false;
          tick();
        }, PAUSE_DELETED);
        return;
      }
    }

    // slight jitter so typing feels organic rather than metronomic
    const speed = deleting ? DELETE_MS : TYPE_MS + Math.random() * 60 - 30;
    setTimeout(tick, speed);
  }

  // visitor entry joins the pool once the real count is known (or the joke # if not)
  freeStatuses.push({ text: '', isVisitor: true });

  if (typewriterTextElement) tick();
</script>
