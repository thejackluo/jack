---
import BaseLayout from '../layouts/Base.astro';
import data from '../data/gallery.json';

const { gallery, works } = data;
const wingA = works.filter((w) => w.wing === 'A');
const wingB = works.filter((w) => w.wing === 'B');

// Asymmetric mosaic: [colSpan, rowSpan] per work index on a 4-column grid.
// Portraits (all works are 3:4) fill their tile with object-fit: cover.
const spansA: [number, number][] = [
  [3, 4], // A12 centrepiece — dominant tile
  [1, 2],
  [1, 2],
];
const spansB: [number, number][] = [
  [2, 4],
  [1, 2],
  [1, 2],
  [1, 2],
  [1, 2],
  [1, 2],
  [1, 2],
  [2, 4],
  [1, 2],
  [1, 2],
  [2, 4],
  [1, 2],
  [1, 2],
  [1, 2],
  [1, 2],
  [1, 2],
  [2, 2],
  [1, 2],
];
const tileClass = (c: number, r: number) =>
  c >= 2 ? `work tile-c${c} tile-r${r}` : `work tile-r${r}`;
const collections = [
  { id: 'of-jack', label: 'Of Jack', works: wingA, spans: spansA },
  { id: 'by-jack', label: 'By Jack', works: wingB, spans: spansB },
];
---

<BaseLayout
  title="Gallery - Jack Luo"
  description={gallery.subtitle}
  currentPage="gallery"
>
  <section id="gallery-section">
    <div class="gallery-wrap">
      <header class="gallery-head">
        <h1 class="gallery-title">Gallery</h1>
        <nav class="collection-switch" aria-label="Switch collection">
          <button class="switch-arrow" data-shift="-1" aria-label="Previous collection">
            &#8249;
          </button>
          {
            collections.map((c, i) => (
              <>
                {i > 0 && <span class="switch-sep" />}
                <button
                  class={i === 0 ? 'switch-label active' : 'switch-label'}
                  data-collection={i}
                >
                  {c.label}
                </button>
              </>
            ))
          }
          <button class="switch-arrow" data-shift="1" aria-label="Next collection">
            &#8250;
          </button>
        </nav>
      </header>

      {
        collections.map((c, i) => (
          <section
            class={i === 0 ? 'collection active' : 'collection'}
            data-panel={i}
            aria-label={c.label}
          >
            <div class="mosaic">
              {c.works.map((w, j) => (
                <figure class={tileClass(...c.spans[j])}>
                  <button
                    class="thumb"
                    data-open={w.id}
                    aria-label={`View ${w.title} full size`}
                  >
                    <img
                      src={w.image}
                      alt={w.description}
                      width={w.width}
                      height={w.height}
                      loading="lazy"
                    />
                    <span class="overlay">
                      <span class="ov-no">{w.id}</span>
                      <span class="ov-title">{w.title}</span>
                      <span class="ov-meta">
                        {w.date} · {w.location}
                      </span>
                      <span class="ov-note">{w.curatorialNote}</span>
                    </span>
                  </button>
                </figure>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <dialog id="lightbox" aria-label="Photograph viewer">
    <div class="lb-stage">
      <button class="lb-btn lb-close" data-close aria-label="Close viewer">
        &times;
      </button>
      <button class="lb-btn lb-prev" data-prev aria-label="Previous photograph">
        &#8249;
      </button>
      <img id="lb-img" alt="" />
      <button class="lb-btn lb-next" data-next aria-label="Next photograph">
        &#8250;
      </button>
    </div>
    <div class="lb-label">
      <strong id="lb-title"></strong>
      <div id="lb-meta"></div>
      <div id="lb-note"></div>
    </div>
    <p id="lb-count"></p>
  </dialog>

  <script define:vars={{ works }}>
    const order = works.map((w) => w.id);
    const dlg = document.getElementById('lightbox');
    const img = document.getElementById('lb-img');
    const titleEl = document.getElementById('lb-title');
    const metaEl = document.getElementById('lb-meta');
    const noteEl = document.getElementById('lb-note');
    const countEl = document.getElementById('lb-count');
    let idx = 0;

    function show(i) {
      idx = (i + works.length) % works.length;
      const w = works[idx];
      img.src = w.image;
      img.alt = w.description;
      titleEl.textContent = `${w.id} — ${w.title}`;
      metaEl.textContent = `${w.date} · ${w.location}`;
      noteEl.textContent = w.curatorialNote;
      countEl.textContent = `${idx + 1} of ${works.length}`;
    }

    document.querySelectorAll('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        show(order.indexOf(b.dataset.open));
        dlg.showModal();
      })
    );
    dlg.querySelector('[data-close]').addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]').addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-next]').addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });

    // Collection switcher — slide between "Of Jack" and "By Jack"
    const labels = [...document.querySelectorAll('.switch-label')];
    const panels = [...document.querySelectorAll('.collection')];
    let active = 0;

    function activate(i, dir) {
      if (i === active) return;
      labels[active].classList.remove('active');
      panels[active].classList.remove('active', 'from-left', 'from-right');
      active = i;
      labels[active].classList.add('active');
      panels[active].classList.add('active', dir > 0 ? 'from-right' : 'from-left');
    }

    labels.forEach((el, i) =>
      el.addEventListener('click', () => activate(i, i > active ? 1 : -1))
    );
    document.querySelectorAll('[data-shift]').forEach((el) =>
      el.addEventListener('click', () => {
        const next = (active + Number(el.dataset.shift) + panels.length) % panels.length;
        activate(next, Number(el.dataset.shift));
      })
    );
  </script>
</BaseLayout>

<style>
  :global(#landing) {
    height: auto !important;
    min-height: auto !important;
  }

  :global(.landing-container) {
    height: auto !important;
    position: relative !important;
  }

  #gallery-section {
    height: auto !important;
    min-height: 100vh;
    background: linear-gradient(180deg, #000000 0%, #14123c 100%);
    padding: calc(72px + 3rem) 0 6rem;
  }

  .collection {
    display: none;
    height: auto;
  }

  .collection.active {
    display: block;
  }

  .collection.from-right {
    animation: slide-right 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .collection.from-left {
    animation: slide-left 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes slide-right {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes slide-left {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .gallery-wrap {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .gallery-head {
    text-align: center;
    margin-bottom: 3rem;
  }

  .gallery-title {
    font-family: 'Dual-300', sans-serif;
    font-size: clamp(2.6rem, 6vw, 4rem);
    font-weight: 300;
    letter-spacing: 0.06em;
    color: #fff;
    margin: 0 0 2rem;
    text-shadow:
      0 0 20px rgba(255, 255, 255, 0.2),
      4px 4px 12px rgba(255, 255, 255, 0.15);
  }

  .collection-switch {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
  }

  .switch-label {
    background: none;
    border: 0;
    padding: 0;
    margin: 0;
    font-family: 'Stellar', sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
    cursor: pointer;
    transition:
      color 0.25s ease,
      text-shadow 0.25s ease;
  }

  .switch-label:hover {
    color: rgba(255, 255, 255, 0.7);
  }

  .switch-label.active {
    color: #fff;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);
  }

  .switch-sep {
    width: 1px;
    height: 1rem;
    background: rgba(255, 255, 255, 0.15);
  }

  .switch-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    margin: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .switch-arrow:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
  }

  /* Asymmetric mosaic */
  .mosaic {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 190px;
    grid-auto-flow: dense;
    gap: 14px;
  }

  .work {
    margin: 0;
    min-height: 0;
  }

  .tile-r2 {
    grid-row: span 2;
  }
  .tile-r3 {
    grid-row: span 3;
  }
  .tile-r4 {
    grid-row: span 4;
  }
  .tile-c2 {
    grid-column: span 2;
  }
  .tile-c3 {
    grid-column: span 3;
  }

  .thumb {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    margin: 0;
    border: 0;
    background: rgba(255, 255, 255, 0.03);
    cursor: zoom-in;
    overflow: hidden;
  }

  .thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .thumb:hover img,
  .thumb:focus-visible img {
    transform: scale(1.04);
  }

  .overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem 1.4rem;
    text-align: left;
    white-space: normal;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 35%,
      rgba(5, 5, 15, 0.88) 100%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .thumb:hover .overlay,
  .thumb:focus-visible .overlay {
    opacity: 1;
  }

  .ov-no {
    font-family: 'Stellar', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.3em;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0.4rem;
  }

  .ov-title {
    font-family: 'Dual-300', sans-serif;
    font-size: 1.3rem;
    font-weight: 300;
    color: #fff;
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .ov-meta {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 0.6rem;
  }

  .ov-note {
    font-size: 0.8rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.75);
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Lightbox */
  dialog#lightbox {
    border: 0;
    padding: 2rem;
    background: transparent;
    max-width: 94vw;
    max-height: 94vh;
    overflow: visible;
  }

  dialog#lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(6px);
  }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lb-img {
    display: block;
    max-width: 86vw;
    max-height: 66vh;
    width: auto;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(20, 20, 30, 0.55);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .lb-btn:hover {
    background: rgba(40, 40, 60, 0.7);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .lb-close {
    top: -1rem;
    right: -1rem;
  }

  .lb-prev {
    left: -1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: -1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-label {
    max-width: 40rem;
    margin: 1.25rem auto 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }

  .lb-label strong {
    display: block;
    font-family: 'Dual-300', sans-serif;
    font-weight: 300;
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  #lb-meta {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.5rem;
  }

  #lb-note {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }

  #lb-count {
    margin: 0.75rem 0 0;
    text-align: center;
    font-family: 'Stellar', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 768px) {
    .collection-switch {
      gap: 0.8rem;
    }

    .switch-label {
      font-size: 0.7rem;
      letter-spacing: 0.2em;
    }

    #gallery-section {
      padding: calc(64px + 2rem) 0 4rem;
    }

    .gallery-wrap {
      padding: 0 1rem;
    }

    .gallery-head {
      margin-bottom: 2rem;
    }

    .mosaic {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 160px;
      gap: 10px;
    }

    .tile-c3 {
      grid-column: span 2;
    }

    .lb-close {
      top: -0.75rem;
      right: 0;
    }

    .lb-prev {
      left: 0;
    }

    .lb-next {
      right: 0;
    }
  }
</style>
