---
import BaseLayout from '../layouts/Base.astro';
import data from '../data/gallery.json';

const { gallery, works } = data;
const wings = gallery.wings.map((wing) => ({
  ...wing,
  works: works.filter((w) => w.wing === wing.id),
}));
---

<BaseLayout
  title="Gallery - Jack Luo"
  description={gallery.subtitle}
  currentPage="gallery"
>
  <section id="gallery-section">
    <div class="gallery-wrap">
      <header class="gallery-head">
        <p class="eyebrow">Gallery</p>
        <h1 class="gallery-title">{gallery.title}</h1>
        <p class="gallery-subtitle">{gallery.subtitle}</p>
        <p class="gallery-intro">{gallery.intro}</p>
      </header>

      {
        wings.map((wing) => (
          <section class="wing" aria-label={`Wing ${wing.id}: ${wing.name}`}>
            <header class="wing-head">
              <h2 class="wing-title">
                Wing {wing.id} <span class="wing-sep">—</span> {wing.name}
              </h2>
              <p class="wing-desc">{wing.description}</p>
            </header>
            <div class="wing-grid">
              {wing.works.map((w) => (
                <figure class={w.centrepiece ? 'work centrepiece' : 'work'}>
                  <button
                    class="thumb"
                    data-open={w.id}
                    aria-label={`View ${w.title} full size`}
                  >
                    <img
                      src={w.image}
                      alt={w.description}
                      width={w.width}
                      height={w.height}
                      loading="lazy"
                    />
                  </button>
                  <figcaption class="wall-label">
                    <p class="work-no">
                      {w.id}
                      {w.centrepiece ? ' · Centrepiece' : ''}
                    </p>
                    <h3 class="work-title">{w.title}</h3>
                    <p class="work-meta">
                      {w.date} · {w.location}
                    </p>
                    <p class="work-meta work-medium">{w.medium}</p>
                    <p class="work-note">{w.curatorialNote}</p>
                  </figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <dialog id="lightbox" aria-label="Photograph viewer">
    <div class="lb-stage">
      <button class="lb-btn lb-close" data-close aria-label="Close viewer">
        &times;
      </button>
      <button class="lb-btn lb-prev" data-prev aria-label="Previous photograph">
        &#8249;
      </button>
      <img id="lb-img" alt="" />
      <button class="lb-btn lb-next" data-next aria-label="Next photograph">
        &#8250;
      </button>
    </div>
    <div class="lb-label">
      <strong id="lb-title"></strong>
      <div id="lb-meta"></div>
      <div id="lb-note"></div>
    </div>
    <p id="lb-count"></p>
  </dialog>

  <script define:vars={{ works }}>
    const order = works.map((w) => w.id);
    const dlg = document.getElementById('lightbox');
    const img = document.getElementById('lb-img');
    const titleEl = document.getElementById('lb-title');
    const metaEl = document.getElementById('lb-meta');
    const noteEl = document.getElementById('lb-note');
    const countEl = document.getElementById('lb-count');
    let idx = 0;

    function show(i) {
      idx = (i + works.length) % works.length;
      const w = works[idx];
      img.src = w.image;
      img.alt = w.description;
      titleEl.textContent = `${w.id} — ${w.title}`;
      metaEl.textContent = `${w.date} · ${w.location} · ${w.medium}`;
      noteEl.textContent = w.curatorialNote;
      countEl.textContent = `${idx + 1} of ${works.length}`;
    }

    document.querySelectorAll('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        show(order.indexOf(b.dataset.open));
        dlg.showModal();
      })
    );
    dlg.querySelector('[data-close]').addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]').addEventListener('click', () => show(idx - 1));
    dlg.querySelector('[data-next]').addEventListener('click', () => show(idx + 1));
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
  </script>
</BaseLayout>

<style>
  :global(#landing) {
    height: auto !important;
    min-height: auto !important;
  }

  #gallery-section {
    height: auto !important;
    min-height: 100vh;
    background: linear-gradient(180deg, #000000 0%, #14123c 100%);
    padding: calc(72px + 4rem) 0 8rem;
  }

  .gallery-wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .gallery-head {
    text-align: center;
    margin-bottom: 6rem;
  }

  .eyebrow {
    font-family: 'Stellar', sans-serif;
    font-size: 0.8rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
    margin: 0 0 1.25rem;
  }

  .gallery-title {
    font-family: 'Dual-300', sans-serif;
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    font-weight: 300;
    color: #fff;
    margin: 0 0 1rem;
    text-shadow:
      0 0 20px rgba(255, 255, 255, 0.2),
      4px 4px 12px rgba(255, 255, 255, 0.15);
  }

  .gallery-subtitle {
    font-family: 'Stellar', sans-serif;
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 1.75rem;
  }

  .gallery-intro {
    max-width: 40rem;
    margin: 0 auto;
    font-size: 1rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
  }

  .wing {
    height: auto;
    margin-bottom: 7rem;
  }

  .wing-head {
    text-align: center;
    margin-bottom: 4rem;
  }

  .wing-title {
    font-family: 'Dual-300', sans-serif;
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 300;
    letter-spacing: 0.08em;
    color: #fff;
    margin: 0 0 0.75rem;
  }

  .wing-sep {
    color: rgba(255, 255, 255, 0.35);
  }

  .wing-desc {
    max-width: 38rem;
    margin: 0 auto;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.5);
  }

  .wing-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 4.5rem 4rem;
    align-items: start;
  }

  .work {
    margin: 0;
  }

  .work.centrepiece {
    grid-column: 1 / -1;
    max-width: 54rem;
    margin: 0 auto;
    width: 100%;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.02);
    cursor: zoom-in;
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .thumb:hover {
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 8px 40px rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .thumb img {
    display: block;
    width: 100%;
    height: auto;
  }

  .wall-label {
    padding-top: 1.1rem;
    text-align: center;
  }

  .work-no {
    font-family: 'Stellar', sans-serif;
    font-size: 0.68rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
    margin: 0 0 0.5rem;
  }

  .work-title {
    font-family: 'Dual-300', sans-serif;
    font-size: 1.35rem;
    font-weight: 300;
    color: #fff;
    margin: 0 0 0.4rem;
  }

  .work-meta {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.55);
    margin: 0.15rem 0;
  }

  .work-medium {
    color: rgba(255, 255, 255, 0.4);
    font-style: italic;
  }

  .work-note {
    max-width: 34rem;
    margin: 0.8rem auto 0;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
  }

  dialog#lightbox {
    border: 0;
    padding: 2rem;
    background: transparent;
    max-width: 94vw;
    max-height: 94vh;
    overflow: visible;
  }

  dialog#lightbox::backdrop {
    background: rgba(0, 0, 0, 0.92);
    backdrop-filter: blur(6px);
  }

  .lb-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lb-img {
    display: block;
    max-width: 86vw;
    max-height: 66vh;
    width: auto;
    height: auto;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .lb-btn {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(20, 20, 30, 0.55);
    backdrop-filter: blur(12px);
    color: #fff;
    font-size: 1.5rem;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .lb-btn:hover {
    background: rgba(40, 40, 60, 0.7);
    border-color: rgba(255, 255, 255, 0.45);
  }

  .lb-close {
    top: -1rem;
    right: -1rem;
  }

  .lb-prev {
    left: -1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-next {
    right: -1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lb-label {
    max-width: 40rem;
    margin: 1.25rem auto 0;
    text-align: center;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.6;
  }

  .lb-label strong {
    display: block;
    font-family: 'Dual-300', sans-serif;
    font-weight: 300;
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 0.3rem;
  }

  #lb-meta {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: 0.5rem;
  }

  #lb-note {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
  }

  #lb-count {
    margin: 0.75rem 0 0;
    text-align: center;
    font-family: 'Stellar', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 768px) {
    #gallery-section {
      padding: calc(64px + 2.5rem) 0 5rem;
    }

    .gallery-wrap {
      padding: 0 1.25rem;
    }

    .gallery-head {
      margin-bottom: 4rem;
    }

    .wing {
      margin-bottom: 5rem;
    }

    .wing-grid {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }

    .work.centrepiece {
      max-width: 100%;
    }

    .lb-close {
      top: -0.75rem;
      right: 0;
    }

    .lb-prev {
      left: 0;
    }

    .lb-next {
      right: 0;
    }
  }
</style>
